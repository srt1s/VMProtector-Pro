<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsmResolver.DotNet" Version="6.0.0-beta.1" />
    <ProjectReference Include="..\VMProtector.Runtime\VMProtector.Runtime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\VMProtector.Runtime\bin\Release\netstandard2.0\VMProtector.Runtime.dll"
                      Link="Embedded\VMProtector.Runtime.dll"
                      LogicalName="VMProtector.Core.Embedded.VMProtector.Runtime.dll" />
    <EmbeddedResource Include="..\..\native\VMProtector.NativeStub\out\VMProtector.NativeStub.Console.exe"
                      Link="Embedded\VMProtector.NativeStub.Console.exe"
                      LogicalName="VMProtector.Core.Embedded.VMProtector.NativeStub.Console.exe" />
    <EmbeddedResource Include="..\..\native\VMProtector.NativeStub\out\VMProtector.NativeStub.Gui.exe"
                      Link="Embedded\VMProtector.NativeStub.Gui.exe"
                      LogicalName="VMProtector.Core.Embedded.VMProtector.NativeStub.Gui.exe" />
  </ItemGroup>
</Project>
