<Application x:Class="VMProtector.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#0F111A" />
        <SolidColorBrush x:Key="BgCard" Color="#161925" />
        <SolidColorBrush x:Key="BgCardAlt" Color="#1C2030" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#2A3045" />
        <SolidColorBrush x:Key="AccentBlue" Color="#63B3ED" />
        <SolidColorBrush x:Key="AccentGreen" Color="#68D391" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextMuted" Color="#8A94A6" />

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
