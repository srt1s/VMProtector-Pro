<Window x:Class="VMProtector.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VMProtector-Pro v2.0 — .NET 8 &amp; PE64 Protection Studio"
        Width="980" Height="710"
        MinWidth="880" MinHeight="640"
        Background="#0F111A"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161925" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="VMPROTECTOR-PRO v2.0" FontSize="20" FontWeight="Bold" Foreground="#63B3ED"/>
                    <TextBlock Text=".NET 8 IL Polymorphic VM + ChaCha20 Vault + C++20 x64 Native Engine (ToprakExternal Edition)"
                               FontSize="12" Foreground="#8A94A6" Margin="0,2,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#1C2030" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBadgeMode" Text="MOD: HAZIR" FontSize="12" FontWeight="SemiBold" Foreground="#68D391"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- File Paths -->
        <Border Grid.Row="1" Background="#161925" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Giriş Binary" VerticalAlignment="Center" Foreground="#CBD5E0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtInputPath" Grid.Row="0" Grid.Column="1" Background="#0F111A" Foreground="#E2E8F0" BorderBrush="#2A3045"
                         Padding="8,6" FontFamily="Consolas" FontSize="12.5" VerticalContentAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Dosya Seç..." Margin="8,0,0,0" Padding="14,6" Background="#252C40" Foreground="#E2E8F0"
                        BorderBrush="#3A4463" Cursor="Hand" Click="BtnBrowseInput_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Çıkış Dosyası" VerticalAlignment="Center" Foreground="#CBD5E0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtOutputPath" Grid.Row="2" Grid.Column="1" Background="#0F111A" Foreground="#E2E8F0" BorderBrush="#2A3045"
                         Padding="8,6" FontFamily="Consolas" FontSize="12.5" VerticalContentAlignment="Center"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Kaydet Yeri..." Margin="8,0,0,0" Padding="14,6" Background="#252C40" Foreground="#E2E8F0"
                        BorderBrush="#3A4463" Cursor="Hand" Click="BtnBrowseOutput_Click"/>
            </Grid>
        </Border>

        <!-- Main Columns -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Protection Passes -->
            <Border Grid.Column="0" Background="#161925" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="KORUMA PROFILI" FontSize="12" FontWeight="Bold" Foreground="#63B3ED" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbPreset" SelectedIndex="0" Background="#0F111A" Foreground="#11111B" Padding="6"
                                  SelectionChanged="CmbPreset_SelectionChanged" Margin="0,0,0,12">
                            <ComboBoxItem Content="ToprakExternal Maximum (.NET 8 + WPF Safe)"/>
                            <ComboBoxItem Content="Balanced Safe (Hızlı + Temel VM)"/>
                            <ComboBoxItem Content="Maximum Stealth (VM + Tool Scan + Stage-2)"/>
                            <ComboBoxItem Content="Native PE64 (C++20 VM + Reflective RAM)"/>
                        </ComboBox>

                        <TextBlock Text=".NET &amp; VM KORUMA KATMANLARI" FontSize="12" FontWeight="Bold" Foreground="#63B3ED" Margin="0,2,0,4"/>
                        <CheckBox x:Name="ChkVm" Content="MSIL -&gt; Polymorphic VM Sanallaştırma" IsChecked="True"/>
                        <CheckBox x:Name="ChkStrings" Content="ChaCha20 String &amp; Secret Vault" IsChecked="True"/>
                        <CheckBox x:Name="ChkCfg" Content="Control Flow Flattening + Opaque Predicates" IsChecked="True"/>
                        <CheckBox x:Name="ChkConst" Content="Numeric Constant Mutation (XOR/ARX)" IsChecked="True"/>
                        <CheckBox x:Name="ChkRename" Content="Akıllı Sembol İsim Gizleme (WPF/BAML Safe)" IsChecked="True"/>
                        <CheckBox x:Name="ChkAntiDebug" Content="Native x64 PIC Shellcode + Anti-Debug (.cctor)" IsChecked="True"/>
                        <CheckBox x:Name="ChkAntiIldasm" Content="Anti-ILDasm + Strip PDB Debug Metadata" IsChecked="True"/>
                        <CheckBox x:Name="ChkStage2" Content="SingleFile Stage-2 RAM Loader (Anti-Extractor)" IsChecked="True"/>
                        <CheckBox x:Name="ChkToolScan" Content="RE Araç Taraması (dnSpy/x64dbg/IDA)" IsChecked="False"/>

                        <TextBlock Text="ÖNCELİK SCOPE FİLTRESİ (Opsiyonel)" FontSize="11.5" FontWeight="Bold" Foreground="#8A94A6" Margin="0,12,0,4"/>
                        <TextBox x:Name="TxtScopeFilter" Background="#0F111A" Foreground="#E2E8F0" BorderBrush="#2A3045"
                                 Padding="6,4" FontFamily="Consolas" FontSize="12" Text="license,security,offset,aim,auth"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Column: Inspector + Live Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#161925" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="HEDEF BINARY ANALİZİ" FontSize="12" FontWeight="Bold" Foreground="#63B3ED" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtInspectSummary"
                                   Text="Bir .exe / .dll dosyası seçin veya pencereye sürükleyip bırakın."
                                   Foreground="#CBD5E0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#161925" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="10" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="DERLEME &amp; KORUMA GÜNLÜĞÜ" FontSize="12" FontWeight="Bold" Foreground="#63B3ED" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Background="#0B0D14" Foreground="#A6E3A1" BorderBrush="#2A3045"
                                 FontFamily="Consolas" FontSize="12" Padding="8" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="#161925" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <ProgressBar x:Name="PrgBuild" Height="14" Minimum="0" Maximum="100" Value="0" Background="#0F111A" Foreground="#63B3ED"/>
                    <TextBlock x:Name="TxtStatus" Text="Beklemede" FontSize="11.5" Foreground="#8A94A6" Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="BtnOpenOutDir" Grid.Column="1" Content="Klasörü Aç" Padding="14,9" Margin="0,0,8,0"
                        Background="#252C40" Foreground="#E2E8F0" BorderBrush="#3A4463" Cursor="Hand" Click="BtnOpenOutDir_Click"/>
                <Button x:Name="BtnProtect" Grid.Column="2" Content="⚡ KORUMAYI BAŞLAT" Padding="20,9" FontWeight="Bold"
                        Background="#63B3ED" Foreground="#0F111A" BorderThickness="0" Cursor="Hand" Click="BtnProtect_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
